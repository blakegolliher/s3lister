# S3 Lister Configuration

[s3]
access_key = "YOUR_ACCESS_KEY"
secret_key = "YOUR_SECRET_KEY"
endpoint   = "https://s3.amazonaws.com"
bucket     = "my-bucket"
prefix     = ""
region     = "us-east-1"

[workers]
# Number of goroutines listing S3 objects (ListObjectsV2)
readers = 32
# Number of goroutines writing Parquet files (one part-NNN.parquet per writer)
writers = 8
# Records buffered between readers and writers (back-pressure knob)
queue_size = 100000
# Goroutines fetching object tags when `scan -tags` is used
# (one GetObjectTagging call per object)
tag_workers = 256

[storage]
# Directory that receives the part-NNN.parquet files.
# Query the whole set with DuckDB: SELECT * FROM 'output_dir/*.parquet'
output_dir = "./s3lister_out"

[logging]
log_file = "./s3lister.log"
